APP_NAME="Laravel Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file

# "log" writes emails to storage/logs/laravel.log. Use smtp in production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Store
SHOP_CURRENCY=$
SHOP_SHIPPING_FEE=800
SHOP_FREE_SHIPPING_OVER=10000
SHOP_TAX_RATE=0
SHOP_EMAIL=shop@example.com

# Payments. A gateway turns on by itself when its keys are filled in.
# Stripe: Dashboard > Developers > API keys / Webhooks (event: checkout.session.completed)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# PayPal: developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_CURRENCY=USD

# Mercado Pago: Your integrations > Credentials (webhook URL: /payment/webhook/mercadopago)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CURRENCY=BRL
